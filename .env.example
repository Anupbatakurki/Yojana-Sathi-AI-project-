# ---------------------------------------------------------------- runtime
ENV=dev                      # dev | test | staging | prod
LOG_LEVEL=INFO
LOG_JSON=false               # true in production (one JSON object per line)

# ---------------------------------------------------------------- LLM
# Gemini key:
LLM_API_KEY=new_gemini_key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3



# ---------------------------------------------------------------- retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
USE_DENSE=true               # false = keyword (BM25) search only
TOP_K=6

# ---------------------------------------------------------------- API protection
API_KEYS=                    # comma-separated; empty disables auth (local dev only!)
RATE_LIMIT_PER_MINUTE=30     # per IP / per UI session; 0 disables
CORS_ORIGINS=                # comma-separated origins allowed to call the API from a browser

# ---------------------------------------------------------------- UI
API_URL=                     # e.g. http://localhost:8000 (empty = run pipeline in-process)
UI_API_KEY=                  # must be one of API_KEYS